<odoo>
    <!-- Record rule for team leader -->
    <record id="group_sale_team_leader" model="res.groups">
        <field name="name">User: Team Leader</field>
        <field name="sequence">15</field>
        <field name="privilege_id" ref="sales_team.res_groups_privilege_sales" />
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]" />
        <field name="comment">
            Team Leader can manage sales orders created by users in their team.
        </field>
    </record>

    <record id="sale_order_team_leader_rule" model="ir.rule">
        <field name="name">Sales Order: Team Leader Access</field>
        <field name="model_id" ref="sale.model_sale_order" />
        <field name="groups" eval="[(4, ref('sale_custom_access.group_sale_team_leader'))]" />
        <field name="domain_force">
            [
            '|',
            ('user_id', '=', user.id),
            ('team_id.user_id', '=', user.id)
            ]
        </field>
    </record>
</odoo>