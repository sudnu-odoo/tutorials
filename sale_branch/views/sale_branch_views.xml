<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Action -->
    <record id="sale_branch_action" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">sale.branch</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- List view -->
    <record id="sale_branch_view_list" model="ir.ui.view">
        <field name="name">sale.branch.list</field>
        <field name="model">sale.branch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Name" width="150" />
                <field name="code" string="Code" width="150" />
                <field name="sequence_id" string="Sequence" width="150" />
            </list>

        </field>
    </record>

    <!-- Search view -->
    <record id="sale_branch_view_search" model="ir.ui.view">
        <field name="name">sale.branch.search</field>
        <field name="model">sale.branch</field>
        <field name="arch" type="xml">

            <search string="Search Branches">
                <!-- Searchable fields -->
                <field name="name" string="Branch Name" />
                <field name="code" string="Branch Code" />
            </search>
        </field>
    </record>
</odoo>