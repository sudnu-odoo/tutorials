<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="report_contact_list" model="ir.actions.report">
        <field name="name">Report Contact List</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">contact.report_contact_list_template</field>
        <field name="report_file">contact.report_contact_list_template</field>
        <field name="print_report_name">'Contact List - %s' % (object.name or
            'Contact').replace('/','')</field>
        <field name="binding_model_id" ref="base.model_res_partner" />
        <field name="binding_type">report</field>
    </record>
</odoo>