<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="report_user_properties" model="ir.actions.report">
        <field name="name">Report User Properties</field>
        <field name="model">res.users</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">estate.report_user_properties_template</field>
        <field name="report_file">estate.report_user_properties_template</field>
        <field name="print_report_name">'User Properties - %s' % (object.name or
            'User').replace('/','')</field>
        <field name="binding_model_id" ref="model_res_users" />
        <field name="binding_type">report</field>
    </record>
</odoo>