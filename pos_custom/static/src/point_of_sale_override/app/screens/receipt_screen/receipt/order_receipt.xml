<templates id="template" xml:space="preserve">
    <t t-name="pos_custom.CongratulatoryText" t-inherit="point_of_sale.OrderReceipt"
            t-inherit-mode="extension">
            <xpath expr="//div[@class='pos-receipt-order-data text-center pt-3']" position="before">
                <div class="pos-receipt-order-data text-center pt-3">
                    <span t-esc="order.config.congratulatory_text" />
                </div>
            </xpath>
        </t>
</templates>