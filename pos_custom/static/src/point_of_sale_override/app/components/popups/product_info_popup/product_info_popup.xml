<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_custom.ProductInfoPopup" t-inherit="point_of_sale.ProductInfoPopup" t-inherit-mode="extension">
        <xpath
                expr="//div[hasclass('financials-order')]"
                position="after">
                <div class='border-top'></div>
                <div class="d-grid gap-2 mt-3"
                    style="grid-template-columns: repeat(2, 1fr);">
                    <div class="section-financials text-start">
                        <h3 class="section-title">Logistics</h3>
                        <div class="grid gap-2">
                            <label class="fw-bold">Weight:</label>
                            <span t-esc="props.info.productInfo.weight" />
                            <label class="fw-bold">Volume:</label>
                            <span t-esc="props.info.productInfo.volume" />
                        </div>
                    </div>
                </div>
            </xpath>
    </t>
</templates>